<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:InternalStyle="clr-namespace:LCLocalizationInterface.Internal.UIStyle"
	xmlns:Limbus="clr-namespace:LCLocalizationInterface.LimbusRegistry"
	xmlns:LimbusIValueConverters="clr-namespace:LCLocalizationInterface.LimbusRegistry.LimbusIValueConverters"
	xmlns:PreviewCreator="clr-namespace:LCLocalizationInterface.LimbusRegistry.PreviewCreator">

    <ResourceDictionary.MergedDictionaries>
        <!--    Its not inherinted from main app's ※ Entanglement Dictionary.xaml!!!!!!!!!!!!!    -->
        <ResourceDictionary Source="/Internal/Resource Dictionaries/IValueConverters.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <Style TargetType="{x:Type PreviewCreator:ColumnTextElementContainer}">
        <Setter Property="Background" Value="Transparent" />
        
        <Setter Property="VerticalOffset" Value="{Binding RelativeSource={RelativeSource Self}, Path=RelatedJsonData.VerticalOffset}" />
        <Setter Property="ContentHorizontalOffset" Value="{Binding RelativeSource={RelativeSource Self}, Path=RelatedJsonData.HorizontalOffset}" />
        <Setter Property="SignatureText" Value="{Binding RelativeSource={RelativeSource Self}, Path=RelatedJsonData.Signature}" />
        
        <Setter Property="Margin" Value="{Binding RelativeSource={RelativeSource Self}, Path=VerticalOffset, Converter={StaticResource DoubleToTopMarginConverter}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PreviewCreator:ColumnTextElementContainer}">
                    <Grid Margin="0 0 0 13">

                        <Image x:Name="TemplateSealedView" HorizontalAlignment="Left" Visibility="Collapsed" />

                        <Grid x:Name="PART_TemplateContentGrid">

                            <Grid x:Name="PART_SignatureGrid" Width="510" Margin="{TemplateBinding SignatureText_HOffset, Converter={StaticResource DoubleToRightMarginConverter}}" HorizontalAlignment="Left" Visibility="Visible">

                                <!--    {DynamicResource TextColumns_ItemSignaturesFont} is presented at the Page.xaml    -->
                                <TextBlock
                                    x:Name="PART_SignatureText"
									Margin="0 10.5 32 0"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									FontFamily="{DynamicResource TextColumns_ItemSignaturesFont}"
									FontSize="31"
									Foreground="#47311e"
									Text="{TemplateBinding SignatureText}"
									TextAlignment="Right">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>


                            <!--    Skill / Passive / Keyword   displayer    -->
                            <Grid x:Name="PART_LocalizationTextViewSite" Margin="{TemplateBinding ContentHorizontalOffset, Converter={StaticResource DoubleToRightMarginConverter}}">

                                <StackPanel>

                                    <TextBlock
                                        x:Name="PART_AlternativeSignatureForSkillSummaryView"
                                        Margin="0 12 0 -8"
                                        TextAlignment="Center"
									    FontFamily="{DynamicResource TextColumns_ItemSignaturesFont}"
                                        FontSize="26"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed"
									    Text="{TemplateBinding SignatureText}"
								        Foreground="#47311e" />

                                    <ContentPresenter x:Name="LocalizationTextViewPresenter" Content="{TemplateBinding LocalizationTextView}" />

                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Grid>
                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RelatedJsonData.Type}" Value="Keyword">
                            <Setter TargetName="PART_SignatureGrid" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>